def main():
    parser = argparse.ArgumentParser(
        description="g15 - Unified AI Engine & Hardware Controller for Dell G15 5530",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    subparsers = parser.add_subparsers(dest="command", help="Available commands")

    # status
    subparsers.add_parser("status", help="Inspect CPU topology, GPU VRAM, and active models")

    # tune
    tune_parser = subparsers.add_parser("tune", help="1-click system performance tuning")
    tune_parser.add_argument("--service", action="store_true", help="Enable systemd persistence service across reboots")
    tune_parser.add_argument("--performance", action="store_true", help="Also engage G-Mode / performance profile (default: preserve balanced)")

    # free
    subparsers.add_parser("free", help="Flush all VRAM and unload background models")
    subparsers.add_parser("unload", help="Alias for 'free'")

    # list
    subparsers.add_parser("list", help="List installed models and recommended roles")

    # chat
    chat_parser = subparsers.add_parser("chat", help="Start interactive chat session")
    chat_parser.add_argument("target", nargs="?", default="coder", help="Preset (coder, reasoner, agent, fast) or path to GGUF")

    # run (alias for chat)
    run_parser = subparsers.add_parser("run", help="Alias for 'chat'")
    run_parser.add_argument("target", nargs="?", default="coder", help="Preset or path to GGUF")

    # serve
    serve_parser = subparsers.add_parser("serve", help="Start OpenAI-compatible API server")
    serve_parser.add_argument("target", nargs="?", default="reasoner", help="Preset or path to GGUF")
    serve_parser.add_argument("--port", type=int, default=SERVER_DEFAULT_PORT, help="Port to bind server (default: 8080)")

    # test
    test_parser = subparsers.add_parser("test", help="Test & benchmark active OpenAI API server")
    test_parser.add_argument("--url", default=f"http://localhost:{SERVER_DEFAULT_PORT}/v1", help="API base URL")
    test_parser.add_argument("--tokens", type=int, default=128, help="Max tokens to generate")
    test_parser.add_argument("--prompt", default=None, help="Prompt text for benchmarking")

    # mode
    mode_parser = subparsers.add_parser("mode", help="Switch power profile (performance, balanced, power-saver)")
    mode_parser.add_argument("target", nargs="?", default="balanced", help="Target mode: performance, balanced, power-saver")

    # balance (alias for mode balanced)
    subparsers.add_parser("balance", help="Quick shortcut to activate balanced mode")

    # gmode (shortcut for mode gmode)
    subparsers.add_parser("gmode", help="Quick shortcut to toggle Game Shift / G-Mode")

    # fan / fans
    fan_parser = subparsers.add_parser("fan", help="Inspect or adjust Dell G15 fans (CPU/GPU fan boost 0-100%%)")
    fan_parser.add_argument("cpu_boost", nargs="?", type=int, default=None, help="CPU fan boost percentage (0-100)")
    fan_parser.add_argument("gpu_boost", nargs="?", type=int, default=None, help="GPU fan boost percentage (0-100)")

    fans_parser = subparsers.add_parser("fans", help="Alias for 'fan'")
    fans_parser.add_argument("cpu_boost", nargs="?", type=int, default=None, help="CPU fan boost percentage (0-100)")
    fans_parser.add_argument("gpu_boost", nargs="?", type=int, default=None, help="GPU fan boost percentage (0-100)")

    # benchmark
    subparsers.add_parser("benchmark", help="Run automated throughput and prompt eval benchmark")

    # torture (death-test)
    subparsers.add_parser("torture", help="Run extreme 5-stage Death Test (saturation, 6x hammer, dirty kill, thermals)")
    subparsers.add_parser("death-test", help="Alias for 'torture'")

    # verify (test-all)
    subparsers.add_parser("verify", help="Run full automated functional & accuracy verification suite")
    subparsers.add_parser("test-all", help="Alias for 'verify'")

    args = parser.parse_args()

    if not args.command:
        cmd_status()
        return

    if args.command == "status":
        cmd_status()
    elif args.command == "tune":
        cmd_tune(args.service, args.performance)
    elif args.command == "mode":
        cmd_mode(args.target)
    elif args.command == "balance":
        cmd_mode("balanced")
    elif args.command == "gmode":
        cmd_gmode()
    elif args.command in ("fan", "fans"):
        cmd_fan(args.cpu_boost, args.gpu_boost)
    elif args.command in ("free", "unload"):
        unload_all_vram()
    elif args.command == "list":
        cmd_list()
    elif args.command in ("chat", "run"):
        cmd_chat(args.target)
    elif args.command == "serve":
        cmd_serve(args.target, args.port)
    elif args.command == "test":
        cmd_test(args.url, args.prompt, args.tokens)
    elif args.command == "benchmark":
        cmd_benchmark()
    elif args.command in ("verify", "test-all"):
        test_script = REPO_DIR / "tests" / "run_all_tests.sh"
        if test_script.exists():
            subprocess.run(["bash", str(test_script)])
        else:
