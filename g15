def cmd_chat(target: str):
    target = target.lower()

    if target in PRESETS:
        preset = PRESETS[target]
        if preset["engine"] == "ollama":
            # For Ollama models, ensure headroom and launch
            ensure_vram_headroom(4000)
            print(f"[+] Starting {preset['model']} via Ollama...")
            os.execvp("ollama", ["ollama", "run", preset["model"]])
        else:
            # Native llama.cpp
            model_path = preset["path"]
            if not model_path.exists():
                print(f"[ERROR] Model file not found at {model_path}")
                print(f"Run: python3 {REPO_DIR}/inference/download_gguf.py --preset qwen14b")
                sys.exit(1)

            ensure_vram_headroom(4500)
            print(f"[+] Starting {model_path.name} via Native llama.cpp...")
            print(f"[+] Pinning threads strictly to Intel P-cores: {P_CORE_AFFINITY}")

            args = [
                "taskset", "-c", P_CORE_AFFINITY,
                "llama-cli",
                "-m", str(model_path),
                "-ngl", str(preset["ngl"]),
                "-t", str(preset["threads"]),
                "-c", str(preset["ctx"]),
                "-fa", "on",
                "-ctk", "q8_0",
                "-ctv", "q8_0",
                "--temp", "0.6",
                "--min-p", "0.05",
                "--repeat-penalty", "1.05",
            ]
            os.execvp("taskset", args)
    elif os.path.exists(target):
        # Custom GGUF file
        ensure_vram_headroom(4500)
        print(f"[+] Starting custom GGUF model: {target}")
        args = [
            "taskset", "-c", P_CORE_AFFINITY,
            "llama-cli",
            "-m", target,
            "-ngl", "24",
            "-t", "6",
            "-c", "8192",
            "-fa", "on",
            "-ctk", "q8_0",
            "-ctv", "q8_0",
            "--temp", "0.6",
            "--min-p", "0.05",
            "--repeat-penalty", "1.05",
        ]
        os.execvp("taskset", args)
    else:
        print(f"[ERROR] Unknown preset or file path: {target}")
        print("Available presets: " + ", ".join(PRESETS.keys()))
        sys.exit(1)


def cmd_serve(target: str, port: int):
    target = target.lower()
    ensure_vram_headroom(4500)

    if target in PRESETS:
        preset = PRESETS[target]
        if preset["engine"] == "llama.cpp":
            model_path = preset["path"]
        else:
            model_path = DEFAULT_14B_GGUF
    elif os.path.exists(target):
        model_path = Path(target)
    else:
        model_path = DEFAULT_14B_GGUF

    if not model_path.exists():
        print(f"[ERROR] Model file not found at {model_path}")
        sys.exit(1)

    print(f"[+] Launching OpenAI-Compatible API Server on http://0.0.0.0:{port}...")
    print(f"[+] Model: {model_path.name}")
    print(f"[+] Binding to P-Cores: {P_CORE_AFFINITY} | FlashAttention-2 ON | Q8_0 KV Cache")

    args = [
        "taskset", "-c", P_CORE_AFFINITY,
        "llama-server",
        "-m", str(model_path),
        "-ngl", "24",
        "-t", "6",
        "-c", "8192",
        "-fa", "on",
        "-ctk", "q8_0",
        "-ctv", "q8_0",
        "--host", "0.0.0.0",
        "--port", str(port),
    ]
    os.execvp("taskset", args)


def cmd_test(base_url: str, prompt: str = None, tokens: int = None):
    test_client = REPO_DIR / "vllm" / "test_client.py"
    if test_client.exists():
        cmd = [sys.executable, str(test_client), "--url", base_url]
        if prompt:
            cmd.extend(["--prompt", prompt])
        if tokens:
            cmd.extend(["--tokens", str(tokens)])
        subprocess.run(cmd)
    else:
        print("[ERROR] test_client.py not found.")


