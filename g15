def get_free_vram_mb() -> int:
    try:
        res = subprocess.run(
            ["nvidia-smi", "--query-gpu=memory.free", "--format=csv,noheader,nounits"],
            capture_output=True,
            text=True,
            check=True,
        )
        return int(res.stdout.strip().split("\n")[0])
    except Exception:
        return 6000


def get_active_gpu_processes():
    processes = []
    try:
        res = subprocess.run(
            ["nvidia-smi", "--query-compute-apps=pid,process_name,used_memory", "--format=csv,noheader"],
            capture_output=True,
            text=True,
            check=True,
        )
        for line in res.stdout.strip().split("\n"):
            line = line.strip()
            if line:
                parts = [p.strip() for p in line.split(",")]
                processes.append(parts)
    except Exception:
        pass
    return processes


def unload_all_vram():
    """Cleanly stops all Ollama models and kills any background llama/vLLM servers."""
    print("[+] Reclaiming GPU VRAM...")
    
    # 1. Stop Ollama models
    if shutil.which("ollama"):
        try:
            res = subprocess.run(["ollama", "ps"], capture_output=True, text=True)
            lines = res.stdout.strip().split("\n")[1:]
            for line in lines:
                parts = line.split()
                if parts:
                    model_name = parts[0]
                    print(f"  -> Unloading Ollama model: {model_name}")
                    subprocess.run(["ollama", "stop", model_name], capture_output=True)
        except Exception:
            pass

    # 2. Terminate background llama-server or vllm
    try:
        subprocess.run(["pkill", "-f", "llama-server"], capture_output=True)
        subprocess.run(["pkill", "-f", "vllm.entrypoints"], capture_output=True)
    except Exception:
        pass

    time.sleep(1)
    free_vram = get_free_vram_mb()
    print(f"[✓] VRAM cleanup complete. Available VRAM: {free_vram} MiB")


def ensure_vram_headroom(required_mb: int = 4200):
    free_mb = get_free_vram_mb()
    if free_mb < required_mb:
        print(f"[!] Low VRAM detected ({free_mb} MiB free). Automatically reclaiming memory...")
        unload_all_vram()


def cmd_status():
    print_banner()
    print("=" * 60)
    print(" SYSTEM HARDWARE & ACCELERATION STATUS")
    print("=" * 60)

    # CPU Information
    cpu_model = platform.processor()
    flags = set()
    if os.path.exists("/proc/cpuinfo"):
        with open("/proc/cpuinfo", "r") as f:
            for line in f:
                if line.startswith("model name") and not cpu_model:
                    cpu_model = line.split(":")[1].strip()
                elif line.startswith("flags"):
                    for flag in line.split(":")[1].strip().split():
                        flags.add(flag.lower())

    print(f"Processor:             {cpu_model}")
    print(f"Physical P-Cores:      Primary threads 0, 2, 4, 6, 8, 10")
    print(f"Vector Acceleration:   {'AVX2, AVX_VNNI (Hardware INT8)' if 'avx_vnni' in flags else 'Standard'}")

    # Scaling Governor & Power Profiles
    gov_file = "/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor"
    gov = "unknown"
    if os.path.exists(gov_file):
        with open(gov_file, "r") as f:
            gov = f.read().strip()

    epp_file = "/sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference"
    epp = "unknown"
    if os.path.exists(epp_file):
        with open(epp_file, "r") as f:
            epp = f.read().strip()

    profile = "unknown"
    if shutil.which("powerprofilesctl"):
        try:
            res = subprocess.run(["powerprofilesctl", "get"], capture_output=True, text=True)
            profile = res.stdout.strip()
        except Exception:
            pass

    plat_profile_file = "/sys/firmware/acpi/platform_profile"
    plat_profile = "unknown"
    if os.path.exists(plat_profile_file):
        with open(plat_profile_file, "r") as f:
            plat_profile = f.read().strip()

    wmax_mode = "unknown"
    wmax_file = "/sys/class/platform-profile/platform-profile-0/profile"
    if os.path.exists(wmax_file):
        try:
            with open(wmax_file, "r") as f:
                wmax_mode = f.read().strip()
        except Exception:
            pass

    cpu_fan_rpm = "N/A"
    gpu_fan_rpm = "N/A"
    for hwmon in Path("/sys/class/platform-profile/platform-profile-0/device/hwmon").glob("hwmon*"):
        try:
            cpu_fan_rpm = hwmon.joinpath("fan1_input").read_text().strip() + " RPM"
            gpu_fan_rpm = hwmon.joinpath("fan2_input").read_text().strip() + " RPM"
        except Exception:
            pass

    print(f"Power Profile:         {profile.upper()} (ACPI: {plat_profile}, EPP: {epp})")
    print(f"Dell Thermal Engine:   AWCC WMAX (Mode: {wmax_mode}, CPU Fan: {cpu_fan_rpm}, GPU Fan: {gpu_fan_rpm})")
    print(f"CPU Scaling Governor:  {gov}")

    # GPU Information
    print("\n" + "-" * 60)
    print(" NVIDIA GPU & MEMORY STATUS")
    print("-" * 60)
    try:
        res = subprocess.run(
            ["nvidia-smi", "--query-gpu=name,driver_version,memory.total,memory.free,temperature.gpu,persistence_mode", "--format=csv,noheader,nounits"],
            capture_output=True,
            text=True,
            check=True,
        )
        name, driver, total, free, temp, persist = [p.strip() for p in res.stdout.strip().split(",")]
        print(f"Device:                {name}")
        print(f"Driver Version:        {driver}")
        print(f"VRAM Capacity:         {total} MiB (Free: {free} MiB)")
        print(f"Temperature:           {temp} °C")
        print(f"Persistence Mode:      {persist} {'[OPTIMAL]' if persist.lower() == 'enabled' else '[DISABLED - Run: g15 tune]'}")
    except Exception as e:
        print(f"[!] GPU inspection failed: {e}")

    # Active GPU Processes
    procs = get_active_gpu_processes()
    if procs:
        print("\nActive GPU Processes:")
        for p in procs:
            print(f"  PID {p[0]}: {p[1]} ({p[2]} VRAM)")
    else:
        print("\nActive GPU Processes:  None (VRAM 100% free for inference)")

    # Host Memory & Swap
    print("\n" + "-" * 60)
    print(" STORAGE & NVME PROTECTION")
    print("-" * 60)
    if os.path.exists("/proc/meminfo"):
        meminfo = {}
        with open("/proc/meminfo", "r") as f:
            for line in f:
                parts = line.split(":")
                if len(parts) == 2:
                    meminfo[parts[0].strip()] = parts[1].strip()
        swap_total = meminfo.get("SwapTotal", "0 kB")
        swap_free = meminfo.get("SwapFree", "0 kB")
        print(f"Swap Space:            Total {swap_total} | Free {swap_free}")
        print("NVMe Protection:       [✓] Swap thrashing disabled (Micron 2550 endurance safe)")

    # Kernel Map Count
    max_map_file = "/proc/sys/vm/max_map_count"
    if os.path.exists(max_map_file):
        with open(max_map_file, "r") as f:
            val = f.read().strip()
        print(f"vm.max_map_count:      {val} {'[OPTIMAL]' if int(val) >= 1048576 else '[SUBOPTIMAL]'}")
    print("=" * 60)


def cmd_tune(enable_service: bool = False, performance: bool = False):
